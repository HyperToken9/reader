{
  "name": "blitz",
  "version": "0.1.0",
  "private": true,
  "description": "Read textbooks aloud on the real page -- PDF, EPUB or a documentation site -- with the spoken words highlighted in place.",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/fetch-espeak.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "node scripts/fetch-espeak.mjs && npm run build && electron-builder",
    "speech:parity": "node scripts/speech-parity.mjs",
    "speech:bench": "node scripts/speech-parity.mjs --bench",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:dist": "BLITZ_SMOKE_BIN=release/linux-unpacked/blitz node scripts/smoke.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "koffi": "3.3.3",
    "onnxruntime-node": "^1.29.0",
    "ort-speech": "npm:onnxruntime-node@1.23.2",
    "pdfjs-dist": "6.3.289",
    "ppu-doclayout": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^7.1.5",
    "ws": "^8.21.3"
  },
  "build": {
    "appId": "dev.blitz.reader",
    "productName": "Blitz",
    "files": [
      "electron/**/*",
      "!electron/**/__pycache__",
      "dist/renderer/**/*",
      "vendor/espeak-ng/**/*",
      "package.json",
      "!node_modules/ort-speech/bin/napi-v6/{darwin,win32}/**",
      "!node_modules/ort-speech/bin/napi-v6/linux/arm64/**",
      "!node_modules/ort-speech/bin/napi-v6/linux/x64/libonnxruntime_providers_{cuda,tensorrt}.so",
      "!node_modules/@koromix/koffi-*/musl_*/**",
      "!node_modules/koffi/{vendor,doc}/**"
    ],
    "extraResources": [
      {
        "from": "licenses",
        "to": "licenses"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "maintainer": "HyperToken9 <HyperToken9@users.noreply.github.com>"
    },
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "vendor/espeak-ng/**",
      "node_modules/koffi/**",
      "node_modules/@koromix/**",
      "node_modules/ort-speech/**"
    ]
  },
  "allowScripts": {
    "onnxruntime-node@1.29.0": true,
    "esbuild@0.28.2": true,
    "electron@44.2.0": true
  },
  "homepage": "https://github.com/HyperToken9/reader",
  "author": "HyperToken9",
  "repository": {
    "type": "git",
    "url": "https://github.com/HyperToken9/reader.git"
  }
}
